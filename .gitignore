#ignore emacs temporary files
*~

#ignore Desktop Services Store
*.DS_Store

#ignore the build directory
/build

#ignore test recovery file
output/Recovery

#ignore temporary data from tests
output/TestsTemporaryData

#ignore file recording prune info
output/Prune

#ignore each test's record of its last execution
output/ExecutionRecords

#ignore the patch a checked run writes when the versioned output moved
output/Drift

#ignore Visual Studio / CLion files
.vs
.idea
out

#ignore various coverage files
*.func.html
*.func-c.html

#ignore python bytecode caches, which the scripts leave beside themselves
__pycache__/
