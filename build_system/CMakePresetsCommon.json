{
  "version": 10,
    "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base-debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "base-release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "base-relwithdebinfo",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "base-binary",
      "hidden": true,
      "binaryDir": "${sourceDir}/../build/${sourceDirName}/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPERIMENTAL_CXX_IMPORT_STD": "d0edc3af-4c50-42ea-a356-e2862fe7a444"
      }
    },
    {
      "name": "base-unix",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "$env{CXX_ASAN_FLAGS} $env{CXX_UBSAN_FLAGS} $env{CXX_COVERAGE_FLAGS} $env{CXX_COLOUR_FLAGS}",
        "CMAKE_EXE_LINKER_FLAGS": "$env{LINKER_ASAN_FLAGS} $env{LINKER_UBSAN_FLAGS} $env{LINKER_COVERAGE_FLAGS}"
      },
      "warnings": {
        "unusedCli": false
      },
      "inherits": ["base-binary"]  
    },  
    {
      "name": "base-asan-unix",
      "hidden": true,
      "environment": {
          "CXX_ASAN_FLAGS": "-fsanitize=address",
          "LINKER_ASAN_FLAGS": "-fsanitize=address"
      }
    },
    {
      "name": "base-ubsan-unix",
      "hidden": true,
      "environment": {
          "CXX_UBSAN_FLAGS": "-fsanitize=undefined -fno-sanitize-recover=undefined",
          "LINKER_UBSAN_FLAGS": "-fsanitize=undefined"
      }
    },
    {
      "name": "base-asan-msvc",
      "hidden": true,
      "cacheVariables": {
          "CMAKE_CXX_FLAGS": "/fsanitize=address /EHsc"
      }
    },
    {
      "name": "base-coverage",
      "hidden": true,
      "environment": {
        "CXX_COVERAGE_FLAGS": "-coverage -fprofile-update=atomic",
        "LINKER_COVERAGE_FLAGS": "-coverage"
      },
      "cacheVariables": {
        "CODE_COVERAGE": "ON"
      }
    },
    {
      "name": "base-bug-report",
      "hidden": true,
      "cacheVariables": {
        "BUG_REPORT": "ON"
      }
    },
    {
      "name": "base-time-trace",
      "hidden": true,
      "cacheVariables": {
        "TIME_TRACE": "ON"
      }
    },
    {
      "name": "base-llvm",
      "hidden": true,
      "environment": {
        "CXX_COLOUR_FLAGS": "-fcolor-diagnostics"
      },
      "cacheVariables": { 
        "WARNING_SUPPRESSIONS": "-Wno-missing-braces;-Wno-braced-scalar-init;-Wno-unused-function;-Wno-unused-lambda-capture"
      },
      "inherits": ["base-unix"]
    },
    {
      "name": "base-homebrew-llvm",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/opt/homebrew/opt/llvm/bin/clang",
        "CMAKE_CXX_COMPILER": "/opt/homebrew/opt/llvm/bin/clang++",
        "CMAKE_CXX_COMPILER_CLANG_SCAN_DEPS": "/opt/homebrew/opt/llvm/bin/clang-scan-deps"
      },
      "inherits": ["base-llvm"]
    },
    {
      "name": "base-gcc",
      "hidden": true,
      "environment": {
        "CXX_COLOUR_FLAGS": "-fdiagnostics-color=always"
      },
      "cacheVariables": { 
        "WARNING_SUPPRESSIONS": "-Wno-comment"
      },
      "inherits": ["base-unix"]
    },
    {
      "name": "base-homebrew-gcc-16",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/opt/homebrew/bin/gcc-16",
        "CMAKE_CXX_COMPILER": "/opt/homebrew/bin/g++-16"
      },
      "inherits": ["base-gcc"]
    },
    {
      "name": "base-linux-gcc-15",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/usr/bin/gcc-15",
        "CMAKE_CXX_COMPILER": "/usr/bin/g++-15"
      },
      "inherits": ["base-gcc"]
    },
    {
      "name": "base-linux-gcc",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/usr/bin/gcc",
        "CMAKE_CXX_COMPILER": "/usr/bin/g++"
      },
      "inherits": ["base-gcc"]
    },
