+
+#pragma once
+
+/*! \file
+    \brief Scratch only, never merge: a trace of where a run of the runner
+    spends its time, for roadmap item 418.
+ */
+
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+#include <fstream>
+#include <functional>
+#include <mutex>
+#include <string_view>
+#include <thread>
+#include <vector>
+
+namespace sequoia::testing::scratch_probe
+{
+  struct event
+  {
+    std::int64_t steady_ns{};
+    std::size_t  thread{};
+    const char*  label{};
+    std::int64_t value{};
+  };
+
+  inline std::mutex         st_Mutex{};
+  inline std::vector<event> st_Events{};
+
+  inline void mark(const char* label, std::int64_t value)
+  {
+    using namespace std::chrono;
+    const auto now{duration_cast<nanoseconds>(steady_clock::now().time_since_epoch()).count()};
+    const auto thread{std::hash<std::thread::id>{}(std::this_thread::get_id())};
+    const std::scoped_lock lock{st_Mutex};
+    st_Events.push_back({now, thread, label, value});
+  }
+
+  /** Marks `label` with 0 on construction and 1 on destruction. */
+  class span
+  {
+  public:
+    explicit span(const char* label) : m_Label{label} { mark(m_Label, 0); }
+    ~span() { mark(m_Label, 1); }
+
+    span(const span&)            = delete;
+    span& operator=(const span&) = delete;
+  private:
+    const char* m_Label;
+  };
+
+  /** Appends the events to `$SEQUOIA_PROBE_DIR/trace.txt` under `heading`,
+      with a pair of clock readings to align the steady clock with wall time,
+      and clears them. Does nothing but clear if the variable is unset.
+   */
+  inline void dump(std::string_view heading)
+  {
+    using namespace std::chrono;
+    const std::scoped_lock lock{st_Mutex};
+    if(const char* dir{std::getenv("SEQUOIA_PROBE_DIR")})
+    {
+      std::ofstream out{std::string{dir} + "/trace.txt", std::ios_base::app};
+      out << "# " << heading
+          << " steady_ns " << duration_cast<nanoseconds>(steady_clock::now().time_since_epoch()).count()
+          << " system_ns " << duration_cast<nanoseconds>(system_clock::now().time_since_epoch()).count() << '\n';
+      for(const auto& e : st_Events)
+        out << e.steady_ns << ' ' << e.thread << ' ' << e.label << ' ' << e.value << '\n';
+    }
+
+    st_Events.clear();
+  }
+}
